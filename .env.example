TAG=localhost本地测试
# 本地开发环境数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=12345678
DB_NAME=postgres

# 数据库初始化模式 INIT_MODE
# skip: 完全跳过初始化
# auto: 自动检测并初始化（默认）
# force: 强制执行数据初始化
# rebuild: 清空并重新初始化所有数据
INIT_MODE=rebuild

# 是否启用 Aerich 迁移
AERICH_ENABLED=true

# MQTT 配置
MQTT_BROKER_HOST=39.100.101.252
MQTT_BROKER_PORT=1883
# MQTT_CLIENT_ID=your_client_id 
# MQTT_USERNAME=your_username 
# MQTT_PASSWORD=your_password 

